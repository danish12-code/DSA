** Basics of Recursion **
package Recursion;

public class Basics {
    static int factorial(int n ){
        if (n == 0){
            return 1;
        }
        else {
            return n * factorial(n-1);
        }
    }
    public static void main(String[] args) {
        System.out.println(factorial(5));

    }
}

