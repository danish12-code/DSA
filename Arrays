 *** SUM OF ALL ARRAYS ***

package Arrays;

public class sumofallArrays {
    public static void main(String[] args) {
        int [] arr = {2,3,1,0,6};
        int sum = 0;
        for (int i = 0; i < arr.length; i++) {
            sum= sum+arr[i];

        }
        System.out.println("Sum = " +sum);
    }
}

