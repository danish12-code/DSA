*** REVERSE OF ARRAY ***

package Arrays;

public class ReverseArray {
    public static void main(String[] args) {
        int [] arr = {3,3,8,9};
        for (int i  = arr.length - 1; i>=0;  i--) {
            System.out.println(arr[i] + " ");

        }

    }
}

