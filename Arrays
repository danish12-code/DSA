*** EVEN SUM OF ARRAY  ***

package Arrays;

public class EvenSum {
    public static void main(String[] args) {
        int [] arr = {2,6,8,9,4,7};
        for (int i = 0; i < arr.length; i++) {
            if( arr[i] % 2 == 0){
                System.out.println(arr[i]);
            }

        }
    }
}

