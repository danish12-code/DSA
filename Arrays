*** COUNT POSITIVE NUMBERS ***

package Arrays;

public class countPositiveNumber {
    public static void main(String[] args) {
        int[] arr = {3, -4, 7, -2, 9};
        int count = 0;
        for (int i = 0; i < arr.length; i++) {
            if (arr[i] > 0) {
                count++;
            }


        }
        System.out.println("positive number = " +count);
    }
}

